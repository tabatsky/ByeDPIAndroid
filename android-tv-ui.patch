+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:clipToPadding="false"
+    android:paddingStart="48dp"
+    android:paddingTop="12dp"
+    android:paddingEnd="48dp"
+    android:paddingBottom="27dp" />
